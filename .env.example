# Required. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Model id; run `npm run check:models` to list what your key can use.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Seconds to wait for the model before showing an error. Raise it if you
# switch GEMINI_MODEL to a stronger (slower) model.
MODEL_TIMEOUT_SECONDS=45

# Optional. Higher limits on the hosted search server. Works without it.
PARALLEL_API_KEY=
SEARCH_MCP_URL=https://search.parallel.ai/mcp

# Optional. Embedding model for finding past chats by meaning. "off" = keywords only.
EMBED_MODEL=gemini-embedding-001

# Optional. A Postgres server. Leave empty to use the embedded database in DATA_DIR (data/pglite).
DATABASE_URL=

# Optional.
PORT=3000

# Optional. Limits that protect your model quota on a public deploy (0 turns one off).
TURNS_PER_HOUR=30
TURNS_PER_DAY=500
NEW_USERS_PER_IP_PER_HOUR=10
# Set to true behind a hosting proxy (Render, Railway, Fly) so limits see the real visitor IP.
TRUST_PROXY=false

# Optional. "Watch this": turns on POST /api/cron/recheck (called daily by .github/workflows/recheck.yml).
# At least 24 characters, e.g. `openssl rand -hex 32`. Unset: re-check with `npm run recheck` only.
CRON_SECRET=
# Optional. Most watches re-checked per call.
RECHECK_BATCH=5

# Optional. Email for watch changes and sign-in links, via Resend (free tier). Both unset = no email at all.
RESEND_API_KEY=
EMAIL_FROM=
# Optional. The site's address for links in emails. On Render it defaults to the service's own URL.
PUBLIC_URL=
# Local only: print emails (with their sign-in links) to the server log instead of sending them.
EMAIL_LOG=false
